# Copie este arquivo para config.properties. O aplicativo usa a API PHP publicada.
app.name=WFCSystem v1
app.version=0.2.0
# A API usa sessão HTTP; não é necessário token JWT nesta primeira versão.
api.baseUrl=https://wfcimoveis.com/sistema/api/v1
# O cliente verifica /health antes do login; o MySQL online é acessado somente pela API PHP.
# O banco local SQLite é criado automaticamente em ~/.wfcsystem/wfcsystem.db.
support.name=Suporte WFC Imóveis
support.email=defina-o-email-de-suporte
support.phone=defina-o-telefone-de-suporte
# FTP: preencha somente no arquivo local config.properties, nunca no Git.
# HostGator informado no acesso ao cPanel; confirme no painel caso o provedor forneça outro host FTP.
ftp.host=br968.hostgator.com.br
ftp.port=21
ftp.username=
ftp.password=
ftp.basePath=/public_html/wfc_storage
ftp.propertiesPath=/public_html/wfc_storage/wfc_imoveis
ftp.testimonialsPath=/public_html/wfc_storage/nossos_clientes/prova_social
# Use usuário FTP dedicado, limitado às pastas de mídia. Não coloque CPF,
# senha do banco, service_role ou senha FTP neste arquivo de exemplo.
